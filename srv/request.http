@server = http://localhost:4004/odata/v4/catalog

###########################################################
# DEPARTMENT
###########################################################

POST http://localhost:4004/odata/v4/catalog/createDepartment
Content-Type: application/json

{
    "departmentName": "Information Technology",
    "description": "Handles SAP CAP Development"
}

###

GET {{server}}/Departments

###########################################################
# CLIENT
###########################################################

POST {{server}}/createClient
Content-Type: application/json

{
    "clientName": "Microsoft",
    "contactPerson": "John Smith",
    "email": "john@microsoft.com",
    "phoneNumber": "+1-1234567890",
    "country": "USA",
    "industry": "Technology",
    "status": "Active"
}

###

GET {{server}}/Clients

###########################################################
# EMPLOYEE
# Replace departmentID with actual Department ID
###########################################################

POST {{server}}/createEmployee
Content-Type: application/json

{
    "firstName": "Aditya",
    "lastName": "Reddy",
    "email": "aditya@company.com",
    "jobTitle": "SAP CAP Developer",
    "joinDate": "2026-10-01",
    "hourlyRate": 1000,
    "status": "Active",
    "departmentID": "PUT_DEPARTMENT_ID_HERE"
}

###

GET {{server}}/Employees

###########################################################
# MANAGER
# Replace employeeID and departmentID
###########################################################

POST {{server}}/createManager
Content-Type: application/json

{
    "employeeID": "PUT_EMPLOYEE_ID_HERE",
    "departmentID": "PUT_DEPARTMENT_ID_HERE",
    "managerLevel": "L1",
    "status": "Active"
}

###

GET {{server}}/Managers

###########################################################
# PROJECT
# Replace clientID and managerID
###########################################################

POST {{server}}/createProject
Content-Type: application/json

{
    "projectCode": "PSA001",
    "projectName": "Enterprise PSA",
    "status": "Active",
    "billingType": "TimeAndMaterial",
    "startDate": "2026-10-01",
    "endDate": "2027-03-31",
    "plannedHours": 1200,
    "consumedHours": 0,
    "clientID": "PUT_CLIENT_ID_HERE",
    "managerID": "PUT_MANAGER_ID_HERE"
}

###

GET {{server}}/Projects

###########################################################
# BUDGET
# Replace projectID
###########################################################

POST {{server}}/createBudget
Content-Type: application/json

{
    "projectID": "PUT_PROJECT_ID_HERE",
    "budgetAmount": 1000000,
    "consumedAmount": 0,
    "remainingAmount": 1000000,
    "billingRateHr": 100,
    "currencyCode": "USD",
    "budgetStatus": "OnTrack"
}

###

GET {{server}}/Budgets

###########################################################
# MILESTONE
# Replace projectID
###########################################################

POST {{server}}/createMilestone
Content-Type: application/json

{
    "projectID": "PUT_PROJECT_ID_HERE",
    "milestoneName": "Development Phase",
    "startDate": "2026-10-15",
    "endDate": "2026-12-15",
    "completionPercent": 0,
    "status": "NotStarted"
}

###

GET {{server}}/Milestones

###########################################################
# TASK
# Replace milestoneID
###########################################################

POST {{server}}/createTask
Content-Type: application/json

{
    "milestoneID": "PUT_MILESTONE_ID_HERE",
    "taskName": "Develop CAP Services",
    "startDate": "2026-10-16",
    "endDate": "2026-11-30",
    "status": "NotStarted",
    "estimatedHours": 200,
    "actualHours": 0
}

###

GET {{server}}/Tasks

###########################################################
# INVOICE
# Replace projectID and clientID
###########################################################

POST {{server}}/createInvoice
Content-Type: application/json

{
    "invoiceNumber": "INV001",
    "projectID": "PUT_PROJECT_ID_HERE",
    "clientID": "PUT_CLIENT_ID_HERE",
    "invoiceDate": "2026-11-01",
    "dueDate": "2026-11-30",
    "billableHours": 100,
    "totalAmount": 10000,
    "taxAmount": 1000,
    "currencyCode": "USD",
    "paymentStatus": "Pending",
    "status": "Draft"
}

###

GET {{server}}/Invoices

###########################################################
# TIMESHEET
# Replace employeeID managerID invoiceID
###########################################################

POST {{server}}/createTimesheet
Content-Type: application/json

{
    "employeeID": "PUT_EMPLOYEE_ID_HERE",
    "approvedByID": "PUT_MANAGER_ID_HERE",
    "invoiceID": "PUT_INVOICE_ID_HERE",
    "weekStartDate": "2026-10-12",
    "weekEndDate": "2026-10-18",
    "totalBillableHours": 40,
    "submittedDate": "2026-10-18",
    "approvedDate": null,
    "status": "Draft"
}

###

GET {{server}}/Timesheets

###########################################################
# TIMESHEET ENTRY
# Replace timesheetID and taskID
###########################################################

POST {{server}}/createTimesheetEntry
Content-Type: application/json

{
    "timesheetID": "PUT_TIMESHEET_ID_HERE",
    "taskID": "PUT_TASK_ID_HERE",
    "workDate": "2026-10-13",
    "hours": 8,
    "billable": true
}

###

GET {{server}}/TimesheetEntries

###########################################################
# BUSINESS ACTIONS
###########################################################

POST {{server}}/submitTimesheet
Content-Type: application/json

{
    "ID": "PUT_TIMESHEET_ID_HERE"
}

###

POST {{server}}/approveTimesheet
Content-Type: application/json

{
    "ID": "PUT_TIMESHEET_ID_HERE"
}

###

POST {{server}}/rejectTimesheet
Content-Type: application/json

{
    "ID": "PUT_TIMESHEET_ID_HERE",
    "reason": "Incorrect Hours"
}

###

POST {{server}}/issueInvoice
Content-Type: application/json

{
    "ID": "PUT_INVOICE_ID_HERE"
}

###

POST {{server}}/markInvoicePaid
Content-Type: application/json

{
    "ID": "PUT_INVOICE_ID_HERE"
}

###########################################################
# FINAL VERIFICATION
###########################################################

###

GET {{server}}/Departments?$expand=employees

